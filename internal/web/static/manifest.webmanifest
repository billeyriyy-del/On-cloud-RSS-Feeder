{
  "name": "Noema",
  "short_name": "Noema",
  "description": "Your self-hosted reader: feeds, podcasts and video, read or listened to.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F2F3F5",
  "theme_color": "#F2F3F5",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Unread", "url": "/?view=unread" },
    { "name": "Saved", "url": "/?view=starred" }
  ]
}
